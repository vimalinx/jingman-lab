<import src="../../utils/banner.wxml"/>
<view class="page"><view class="brand">京漫便民 · 店员端</view><template is="banner" data="{{error: error}}"/><view class="section">{{user.name}}</view><view class="stats" wx:if="{{d}}"><view class="card">累计订单<view class="stat">{{d.order_count}}</view></view><view class="card">模拟净收款<view class="stat">¥{{d.net}}</view></view><view class="card">待接单<view class="stat">{{d.waiting}}</view></view><view class="card">低库存<view class="stat">{{d.low_stock}}</view></view></view><view class="section">常用功能</view><view class="menu"><button data-page="orders" bindtap="go">接单 / 拣货 / 核销</button><button wx:if="{{user.role==='manager'}}" data-page="inventory" bindtap="go">商品 / 库存 / 模拟POS</button><button wx:if="{{user.id===10}}" data-page="lab" bindtap="go">故障演练 / 对账</button><button data-page="rider" bindtap="go">模拟配送任务</button><button bindtap="connect">切换演练身份</button></view><view class="foot">详细分类、营销、设置和导出工具见同包网页管理端。两端使用同一数据库。</view></view>

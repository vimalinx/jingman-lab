<import src="../../utils/banner.wxml"/>
<view class="page"><template is="banner" data="{{error: error}}"/><view wx:if="{{o}}"><view class="status"><view class="title">{{o.label}}</view><view class="sub">{{o.nextStep}}</view><view class="mono">{{o.number}}</view><view class="actions" wx:if="{{user.role==='customer'&&o.state==='pending_payment'}}"><button class="primary" bindtap="pay" data-success="true">模拟微信付款</button><button bindtap="pay" data-success="false">模拟失败</button><button class="danger" bindtap="cancel">取消订单</button></view><button class="small" bindtap="load">刷新状态</button></view><view class="card"><view class="section">{{o.method==='pickup'?'到店自提':'门店配送'}}</view><view wx:if="{{o.method==='delivery'}}" class="sub">{{o.address.name}} {{o.address.mobile}}<view/>{{o.address.address}}</view><view wx:if="{{user.role==='customer'&&o.method==='pickup'&&(o.state==='ready'||o.state==='completed')}}"><view class="sub">请出示自提码</view><view class="code">{{o.pickup_code}}</view></view><view class="line" wx:for="{{o.items}}" wx:key="id"><image src="{{item.imageURL}}" mode="aspectFit"/><view class="grow"><view>{{item.name}} ×{{item.quantity}}</view><view class="sub">缺货{{item.shortage_qty}} · 已拣{{item.picked_qty}}</view><button class="danger small" wx:if="{{user.role!=='customer'&&o.state==='picking'}}" disabled="{{item.shortage_qty+item.picked_qty>=item.quantity}}" data-line="{{item.id}}" bindtap="shortage">缺1件退款</button></view><text>¥{{item.net}}</text></view><view wx:if="{{o.method==='delivery'&&o.shipping_detail}}"><view class="sub">配送计费重量 {{o.weight}}</view><view class="row spread"><text>基础配送费</text><text>¥{{o.baseShipping}}</text></view><view class="row spread"><text>超重附加费</text><text>¥{{o.extraShipping}}</text></view></view><view class="row spread"><text>配送费合计</text><text>¥{{o.shipping}}</text></view><view class="row spread bill"><text>商品金额</text><text>¥{{o.subtotal}}</text></view><view class="row spread bill"><text>优惠抵扣</text><text>−¥{{o.discount}}</text></view><view class="row spread bill"><text>应付合计</text><text class="price">¥{{o.total}}</text></view><view class="sub">已付¥{{o.paid}} · 已退¥{{o.refunded}}</view><button wx:if="{{store.local_preview&&user.role==='customer'&&(o.state==='paid'||o.state==='picking'||o.state==='ready'||o.state==='delivering')}}" bindtap="cancel">{{o.state==='delivering'?'取消（扣2元配送费）':'取消并退款'}}</button><view wx:if="{{user.role!=='customer'}}"><view class="actions"><button wx:if="{{o.state==='paid'}}" class="primary" bindtap="accept">接单并拣货</button><button wx:if="{{o.state==='picking'}}" bindtap="pick">剩余商品全部拣齐</button><button wx:if="{{o.state==='picking'}}" class="primary" bindtap="ready">完成打包</button><button wx:if="{{o.state==='ready'&&o.method==='delivery'&&!o.delivery}}" class="primary" bindtap="dispatch">呼叫模拟骑手</button><button wx:if="{{user.role==='manager'&&(o.state==='paid'||o.state==='picking'||o.state==='ready')}}" class="danger" bindtap="cancel">取消并退款</button></view><form wx:if="{{o.state==='ready'&&o.method==='pickup'}}" bindsubmit="pickup"><input name="code" type="number" maxlength="6" placeholder="输入顾客的6位自提码"/><button form-type="submit" class="primary">确认核销</button></form></view></view><view class="card" wx:if="{{o.delivery}}"><view class="section">模拟配送</view><view>{{o.delivery.courier}} · {{o.delivery.state}}</view><view class="foot">状态由模拟骑手回调推进；不是实时GPS轨迹。</view></view><view class="card" wx:if="{{o.refunds.length}}"><view class="section">退款与售后</view><view wx:for="{{o.refunds}}" wx:key="id" class="bill"><text>¥{{item.amount}} · {{item.state}}</text><view class="sub">{{item.reason}}</view><button wx:if="{{user.role==='manager'&&item.state==='requested'}}" class="small primary" bindtap="approve" data-id="{{item.id}}">同意售后退款</button></view></view><form class="card" bindsubmit="aftersale" wx:if="{{user.role==='customer'&&o.state==='completed'}}"><textarea name="reason" placeholder="售后原因，不自动回补实物库存"/><button form-type="submit">申请剩余实付金额退款</button></form><view class="card"><view class="section">订单的每一步</view><view wx:for="{{o.timeline}}" wx:key="index" class="timeline">{{item.label}}</view></view></view></view>

<import src="../../utils/banner.wxml"/>
<view class="page"><view class="row spread"><view class="title">订单记录</view><button class="small" bindtap="load">刷新</button></view><template is="banner" data="{{error: error}}"/><view class="card" wx:if="{{pendingSubmission}}"><view class="section">有一笔提交结果待确认</view><view class="sub">可能已经建单；请先恢复原请求，避免重复下单。</view><button class="primary" bindtap="resume">恢复待确认订单</button></view><view wx:for="{{orders}}" wx:key="id" class="card" bindtap="open" data-id="{{item.id}}"><view class="row spread"><text>{{item.method==='pickup'?'到店自提':'门店配送'}}</text><text class="badge">{{item.label}}</text></view><view class="sub">{{item.number}}</view><view class="line" wx:for="{{item.items}}" wx:for-item="line" wx:key="id"><image src="{{line.imageURL}}" mode="aspectFit"/><view class="grow">{{line.name}} ×{{line.quantity}}</view></view><view class="row spread"><text>应付</text><text class="price">¥{{item.total}}</text></view></view><view wx:if="{{!orders.length}}" class="empty">这里还没有订单</view></view>

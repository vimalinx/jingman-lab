<import src="../../utils/banner.wxml"/>
<view class="page"><view class="row spread"><view class="title">配送任务</view><button class="small" bindtap="onShow">刷新</button></view><template is="banner" data="{{error: error}}"/><view class="card" wx:for="{{tasks}}" wx:key="id"><view class="mono">{{item.number}}</view><view class="section">{{item.state}}</view><view>{{item.contact}} {{item.mobile_masked}}</view><view class="sub">{{item.address}}</view><button wx:if="{{item.button}}" class="primary" data-id="{{item.id}}" data-state="{{item.next}}" bindtap="advance">{{item.button}}</button></view><view wx:if="{{!tasks.length}}" class="empty">还没有配送任务</view><button bindtap="connect">切换演练身份</button></view>

<import src="../../utils/banner.wxml"/>
<view class="page"><view class="title">购物车</view><template is="banner" data="{{error: error}}"/><view class="card line" wx:for="{{items}}" wx:key="id"><checkbox checked="{{item.selected}}" disabled="{{!item.valid}}" color="#168849" bindtap="select" data-id="{{item.id}}"/><image src="{{item.imageURL}}" mode="aspectFit"/><view class="grow"><view class="name">{{item.name}}</view><view wx:if="{{item.pickup_only}}" class="sub">仅限自提</view><view class="sub">{{item.unit}} {{item.valid?'':'· 库存不足/已下架'}}</view><view class="price">¥{{item.price}}</view><view class="step"><button data-id="{{item.id}}" data-delta="-1" bindtap="quantity">−</button><text>{{item.quantity}}</text><button disabled="{{!item.valid}}" data-id="{{item.id}}" data-delta="1" bindtap="quantity">+</button></view></view></view><view class="card" wx:if="{{items.length}}"><view class="row spread"><text>合计</text><text class="price">¥{{total}}</text></view><button class="orange" style="margin-top:25rpx" bindtap="checkout">去结算</button></view><view wx:else class="empty">购物车还空着<button bindtap="shop">去逛好物</button></view></view>

<import src="../../utils/banner.wxml"/>
<view class="page"><template is="banner" data="{{error: error}}"/><view wx:if="{{p}}"><image class="detail-photo" src="{{p.imageURL}}" mode="aspectFit"/><view class="card"><view class="title">{{p.name}}</view><view class="sub">{{p.description}}</view><view class="sub" wx:if="{{p.pickup_only}}">{{p.fulfillment_note||'仅限自提'}}</view><view><text class="price">¥{{p.price}}</text><text class="old" wx:if="{{p.oldPrice}}">¥{{p.oldPrice}}</text></view><view class="section">规格</view><view class="categories"><button class="chip {{p.id===item.id?'active':''}}" wx:for="{{variants}}" wx:key="id" bindtap="variant" data-id="{{item.id}}">{{item.unit}}</button></view><view class="row spread"><view>数量 · 可售{{p.available}}</view><view class="step"><button data-delta="-1" bindtap="quantity">−</button><text>{{quantity}}</text><button data-delta="1" bindtap="quantity">+</button></view></view><view class="actions"><button bindtap="favorite" class="plain">收藏</button><button bindtap="add" disabled="{{!p.valid}}">加入购物车</button><button bindtap="buy" disabled="{{!p.valid}}" class="primary">立即购买</button></view></view></view></view>

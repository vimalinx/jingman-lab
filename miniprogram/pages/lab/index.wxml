<import src="../../utils/banner.wxml"/>
<view class="page"><view class="title">联调实验室</view><template is="banner" data="{{error: error}}"/><view class="card" wx:if="{{report}}"><view class="section">{{report.ok?'所有账本一致':'存在未确认或异常记录'}}</view><view class="sub">已检查{{report.checked_orders}}笔订单 / {{report.checked_skus}}个SKU</view><view class="bill">模拟收款 ¥{{report.paid}}</view><view class="bill">模拟退款 ¥{{report.refunded}}</view></view><view class="card"><view class="section">故障注入</view><view class="row spread bill" wx:for="{{faults}}" wx:key="key"><text>{{item.title}}</text><switch color="#168849" checked="{{item.enabled}}" data-key="{{item.key}}" bindchange="fault"/></view><view class="actions"><button bindtap="worker" class="primary">重试任务</button><button bindtap="sample">生成演练订单</button></view></view><view class="card"><view class="section">可靠任务队列</view><view wx:for="{{jobs}}" wx:key="id" class="bill"><view>{{item.kind}} · {{item.state}} · 尝试{{item.attempts}}次</view><view class="sub" wx:if="{{item.error}}">{{item.error}}</view></view></view></view>

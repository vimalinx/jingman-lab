<import src="../../utils/banner.wxml"/>
<view class="page"><view class="row spread header"><view class="brand">京漫便民</view><view class="badge">{{store.open?'营业中':'已打烊'}}</view></view><view class="sub">{{store.name}} · 门店自提 / 配送</view><template is="banner" data="{{error: error}}"/><input placeholder="搜索商品，如：香蕉、牛奶" confirm-type="search" bindconfirm="search"/><view class="hero" bindtap="category"><image src="{{hero}}" mode="aspectFill"/><view class="hero-copy"><view class="hero-title">新鲜的日常，<view/>就在你身边。</view><view class="sub">好食材，让生活有滋有味。</view></view></view><view class="home-categories"><view class="chip" wx:for="{{categories}}" wx:key="id" data-id="{{item.id}}" bindtap="category">{{item.name}}</view><view class="chip" data-id="0" bindtap="category">全部分类 ›</view></view><view class="section">今日推荐</view><view class="grid"><view class="product" wx:for="{{products}}" wx:key="id"><image class="photo" src="{{item.imageURL}}" mode="aspectFit" data-id="{{item.id}}" bindtap="detail"/><view class="info"><view class="badge">{{item.available?item.tag:'已售罄'}}</view><view class="name" data-id="{{item.id}}" bindtap="detail">{{item.name}}</view><view class="sub">{{item.unit}}</view><view class="row spread"><text class="price">¥{{item.price}}</text><button class="add" data-id="{{item.id}}" bindtap="add" disabled="{{!item.valid}}">+</button></view></view></view></view></view>

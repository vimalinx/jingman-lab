<import src="../../utils/shopping.wxml"/>
<import src="../../utils/banner.wxml"/>
<view class="page"><view wx:if="{{pickupOrders.length}}" class="pickup-notice"><view class="row spread"><view class="section">自提已备好，请来取货</view><text class="badge">待取货 {{pickupOrders.length}} 单</text></view><scroll-view scroll-y class="pickup-list"><view class="pickup-order" wx:for="{{pickupOrders}}" wx:key="id"><view class="sub">订单 {{item.number}}</view><view class="row spread"><view><view class="sub">向店员出示核销码</view><view class="pickup-code-large">{{item.pickup_code}}</view></view><button class="small" data-id="{{item.id}}" bindtap="pickupDetail">查看订单</button></view></view></scroll-view><view class="sub">成功核销取货后，提醒会自动消失。</view><view class="error" wx:if="{{pickupOffline}}">连接中断，取货状态尚未更新，请刷新确认。</view></view><view class="row spread header"><view class="brand">京漫便民</view><view class="badge">{{store.open?'营业中':'已打烊'}}</view></view><view class="sub">{{store.name}} · 门店自提 / 配送</view><template is="banner" data="{{error: error}}"/><input placeholder="搜索商品，如：香蕉、牛奶" confirm-type="search" bindconfirm="search"/><view class="hero" bindtap="category"><image src="{{hero}}" mode="aspectFill"/><view class="hero-copy"><view class="hero-title">新鲜的日常，<view/>就在你身边。</view><view class="sub">好食材，让生活有滋有味。</view></view></view><view class="home-categories"><view class="chip" wx:for="{{categories}}" wx:key="id" data-id="{{item.id}}" bindtap="category">{{item.name}}</view><view class="chip" data-id="0" bindtap="category">全部分类 ›</view></view><view class="card first-guide"><view class="section">第一次来？这样买就好</view><view>选商品 → 查看购物车 → 确认自提或配送 → 下单付款</view><view class="sub">底部可随时查看已选清单。本次为体验购物，付款不会扣真钱。</view></view><view class="section">今日推荐</view><view class="grid"><view class="product" wx:for="{{products}}" wx:key="id"><image class="photo" src="{{item.imageURL}}" mode="aspectFit" data-id="{{item.id}}" bindtap="detail"/><view class="info"><view class="badge">{{item.available?item.tag:'已售罄'}}</view><view class="name" data-id="{{item.id}}" bindtap="detail">{{item.name}}</view><view class="sub">{{item.unit}}</view><view wx:if="{{item.inCart}}" class="in-cart">已加 {{item.inCart}} 件</view><view class="row spread"><text class="price">¥{{item.price}}</text><button class="add" data-id="{{item.id}}" bindtap="add" disabled="{{!item.valid||shoppingBusy}}">+</button></view></view></view></view></view>

<template is="shopping" data="{{shoppingCart,shoppingCount,shoppingSelected,shoppingTotal,shoppingOpen,shoppingBusy}}"/>

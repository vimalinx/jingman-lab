<import src="../../utils/shopping.wxml"/>
<import src="../../utils/banner.wxml"/>
<view class="page"><view class="title">商品分类</view><template is="banner" data="{{error: error}}"/><input placeholder="搜索好物" value="{{q}}" bindconfirm="search" confirm-type="search"/><scroll-view scroll-x class="category-strip"><view class="category-track"><view class="chip {{cat===0?'active':''}}" data-id="0" bindtap="select">全部</view><view class="chip {{cat===item.id?'active':''}}" wx:for="{{categories}}" wx:key="id" data-id="{{item.id}}" bindtap="select">{{item.name}}</view></view></scroll-view><view class="sub">共 {{total}} 条商品 · 第 {{page}} / {{pages}} 页</view><view class="sub" wx:if="{{loading}}">正在查询商品…</view><view style="margin-top:24rpx"><view class="card line" wx:for="{{products}}" wx:key="id"><image src="{{item.imageURL}}" mode="aspectFit" data-id="{{item.id}}" bindtap="detail"/><view class="grow"><view class="name" bindtap="detail" data-id="{{item.id}}">{{item.name}}</view><view class="sub">{{item.unit}} · 可售{{item.available}}</view><view wx:if="{{item.pickup_only}}" class="sub">仅限自提</view><view class="price">¥{{item.price}}</view><view wx:if="{{item.inCart}}" class="in-cart">已加 {{item.inCart}} 件</view></view><button class="add" bindtap="add" data-id="{{item.id}}" disabled="{{!item.valid||shoppingBusy}}">+</button></view><view wx:if="{{!products.length&&!loading&&!error}}" class="empty">没有找到好物，换个关键词试试。</view></view><view class="pager" wx:if="{{total}}"><button class="small" data-delta="-1" bindtap="turn" disabled="{{loading||page<=1}}">上一页</button><text>{{page}} / {{pages}}</text><button class="small" data-delta="1" bindtap="turn" disabled="{{loading||page>=pages}}">下一页</button></view></view>

<template is="shopping" data="{{shoppingCart,shoppingCount,shoppingSelected,shoppingTotal,shoppingOpen,shoppingBusy}}"/>

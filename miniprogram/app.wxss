rap:wrap;gap:15rpx;margin:23rpx 0}.chip{font-size:24rpx;padding:12rpx 22rpx;background:white;border:1rpx solid #e4eadf;border-radius:30rpx}.chip.active{background:#168849;color:white}.grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx}.product{border-radius:23rpx;background:white;border:1rpx solid #e5eddf;overflow:hidden}.photo{width:100%;height:250rpx;display:block}.info{padding:8rpx 20rpx 22rpx}.name{font-weight:650;font-size:30rpx;line-height:1.7}.add{border-radius:50%;width:55rpx;height:55rpx;padding:5rpx;line-height:45rpx;background:#168849;color:white;font-size:38rpx;flex-shrink:0}.error{padding:19rpx;background:#fff0e5;color:#b86136;border:1rpx solid #edcead;border-radius:16rpx;margin:15rpx 0;line-height:1.7}.line{display:flex;align-items:center;gap:19rpx;padding:21rpx 0;border-bottom:1rpx solid #edf0e8}.line image{width:130rpx;height:140rpx;flex-shrink:0}.line .name{font-size:28rpx}.step{display:flex;align-items:center;gap:15rpx}.step button{padding:11rpx 16rpx;min-width:51rpx}.bill{padding:13rpx 0}.actions{display:flex;flex-wrap:wrap;gap:17rpx;margin:24rpx 0}.actions button{flex:1;min-width:140rpx}.status{background:#e5f3da;border-radius:25rpx;padding:30rpx;margin-bottom:24rpx}.code{font-size:68rpx;letter-spacing:14rpx;color:#168849;font-weight:700}.timeline{border-left:3rpx solid #c9dbbd;padding-left:23rpx;margin:18rpx 0}.stats{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.stats .card{margin:0}.stat{font-size:49rpx;font-weight:700;margin-top:15rpx}.menu button{margin-bottom:15rpx;text-align:left;background:white;padding:30rpx}.avatar{width:130rpx;height:130rpx;border-radius:50%;border:5rpx solid white}.profile{background:#168849;color:white;padding:35rpx;border-radius:28rpx;margin-bottom:24rpx}.profile .sub{color:#d6efce}.detail-photo{width:100%;height:450rpx;border-radius:25rpx}.select{background:#f1f6eb;padding:20rpx;border-radius:15rpx;margin:15rpx 0}.foot{font-size:22rpx;color:#9aa78d;line-height:1.8;margin:22rpx 0}.header{margin:10rpx 0 25rpx}.empty{text-align:center;padding:60rpx 20rpx;color:#7d916f;background:white;border-radius:25rpx}.label{font-weight:650;margin-top:18rpx}.mono{font-family:monospace;font-size:23rpx;word-break:break-all}
/* Forms are native components: explicitly make card wrappers block-level. */
form{display:block;box-sizing:border-box;width:100%;min-width:0}
.category-strip{white-space:nowrap;width:100%;margin:20rpx 0}
.category-strip .category-track{display:inline-flex;align-items:center;gap:16rpx;padding:4rpx 0}
.category-strip .chip{flex-shrink:0;white-space:nowrap;max-width:540rpx;overflow:hidden;text-overflow:ellipsis}
.home-categories{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12rpx;margin:20rpx 0}
.home-categories .chip{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;text-align:center;padding:14rpx 10rpx}
.pager{margin:24rpx 0;display:flex;align-items:center;justify-content:space-between;gap:16rpx}
.pager text{font-size:24rpx}

.shopping-space{height:190rpx}.shopping-dock{position:fixed;bottom:0;left:0;right:0;background:#fff;box-shadow:0 -4rpx 24rpx #163d2020;z-index:40;padding:18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));display:flex;gap:20rpx;align-items:center}.shopping-dock .sub{font-size:20rpx}.shopping-mask{position:fixed;inset:0;background:#0007;z-index:60;display:flex;align-items:flex-end}.shopping-sheet{width:100%;background:#fff;border-radius:28rpx 28rpx 0 0;padding:26rpx 24rpx calc(26rpx + env(safe-area-inset-bottom));box-sizing:border-box}.shopping-items{max-height:60vh}.shopping-items .step{flex-shrink:0}.shopping-items .line image{width:100rpx;height:100rpx}.in-cart{font-size:22rpx;color:#168849;font-weight:600}.checkout-fixed{position:fixed;bottom:0;left:0;right:0;background:#fff;z-index:40;padding:20rpx 26rpx calc(20rpx + env(safe-area-inset-bottom));box-shadow:0 -4rpx 24rpx #163d2020;display:flex;align-items:center;justify-content:space-between}.checkout-fixed button{margin:0}.checkout-space{height:180rpx}

.pickup-notice{position:sticky;top:0;z-index:30;background:#fff9e9;border:2rpx solid #f0cb7e;border-radius:22rpx;padding:22rpx;margin-bottom:22rpx;box-shadow:0 8rpx 24rpx #59421518}.pickup-list{max-height:340rpx}.pickup-order+.pickup-order{border-top:1rpx solid #ecd9b0;padding-top:16rpx;margin-top:16rpx}.pickup-code-large{font-size:60rpx;letter-spacing:8rpx;font-weight:800;color:#154f32}.pickup-notice .section{margin:0}.pickup-notice .sub{font-size:22rpx}

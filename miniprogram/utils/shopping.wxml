<template name="shopping">
<view class="shopping-space"/>
<view class="shopping-dock"><view class="grow" bindtap="cartOpen"><view>{{shoppingCount?'已加入 '+shoppingCount+' 件':'购物车还空着'}} · 查看清单 ↑</view><view class="price">¥{{shoppingTotal}}</view><view class="sub">已勾选商品金额 · 优惠与运费结算时确认</view></view><button class="orange small" bindtap="cartCheckout" disabled="{{!shoppingSelected||shoppingBusy}}">去结算</button></view>
<view wx:if="{{shoppingOpen}}" class="shopping-mask" bindtap="cartClose"><view class="shopping-sheet" catchtap="cartNoop"><view class="row spread"><view class="section">已加入 {{shoppingCount}} 件</view><button class="small" bindtap="cartClose">关闭</button></view><scroll-view scroll-y class="shopping-items"><view wx:if="{{!shoppingCart.length}}" class="empty">还没有选择商品<view class="sub">点击商品旁的 +，这里会显示已选清单。</view><button bindtap="cartClose">继续选购</button></view><view class="line" wx:for="{{shoppingCart}}" wx:key="id"><image src="{{item.imageURL}}" mode="aspectFit"/><view class="grow"><view>{{item.name}}</view><view class="sub">{{item.unit}} · {{item.selected?'已勾选':'未勾选'}}{{item.valid?'':' · 库存不足/已下架'}}</view><view class="price">¥{{item.price}}</view></view><view class="step"><button bindtap="cartAdjust" data-id="{{item.id}}" data-delta="-1" disabled="{{shoppingBusy}}">−</button><text>{{item.quantity}}</text><button bindtap="cartAdjust" data-id="{{item.id}}" data-delta="1" disabled="{{shoppingBusy||!item.valid||item.quantity>=item.available}}">+</button></view></view></scroll-view><button bindtap="cartPage">进入购物车勾选商品</button></view></view>
</template>
